# Application
FINRAG_ENVIRONMENT=development
FINRAG_LOG_LEVEL=INFO
FINRAG_API_HOST=127.0.0.1
FINRAG_API_PORT=8000
FINRAG_FRONTEND_API_URL=http://127.0.0.1:8000

# The hosted provider and model remain intentionally unselected.
FINRAG_LLM_PROVIDER=mock
FINRAG_LLM_BASE_URL=
FINRAG_LLM_MODEL=
FINRAG_LLM_API_KEY=

# Retrieval defaults (the revision is pinned for reproducibility)
FINRAG_EMBEDDING_MODEL=BAAI/bge-m3
FINRAG_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
FINRAG_EMBEDDING_DEVICE=cpu
FINRAG_EMBEDDING_BATCH_SIZE=8
FINRAG_CHUNK_SIZE=450
FINRAG_CHUNK_OVERLAP=75
FINRAG_MIN_CHUNK_TOKENS=20
FINRAG_RETRIEVAL_TOP_K=5

